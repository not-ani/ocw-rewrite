{
  "name": "ocw-rewrite",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "convex": "1.43.0",
      "@types/node": "^20",
      "@tailwindcss/postcss": "^4.1.16",
      "typescript": "^5",
      "dotenv": "^17.2.2",
      "next": "16.3.0",
      "arktype": "^2.1.0",
      "next-themes": "^0.4.6",
      "tailwindcss": "^4.1.16",
      "effect": "^3.19.14",
      "vitest": "^2.1.8"
    },
    "catalogs": {
      "react19": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "react": "19.2.8",
        "react-dom": "19.2.8"
      }
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @ocw/backend dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint . && oxlint --type-aware .",
    "lint:fix": "oxlint --fix . && oxlint --type-aware .",
    "lint:ws": "bunx sherif@latest",
    "test:e2e": "turbo -F web test:e2e",
    "test:e2e:ui": "turbo -F web test:e2e:ui",
    "test:e2e:headed": "turbo -F web test:e2e:headed",
    "test:e2e:debug": "turbo -F web test:e2e:debug",
    "test:e2e:report": "turbo -F web test:e2e:report",
    "test:e2e:install": "turbo -F web test:e2e:install",
    "dev:setup": "turbo -F @ocw/backend dev:setup",
    "test:backend": "turbo -F @ocw/backend test",
    "test:backend:watch": "turbo -F @ocw/backend test:watch",
    "test:backend:coverage": "turbo -F @ocw/backend test:coverage"
  },
  "devDependencies": {
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.3.10",
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
