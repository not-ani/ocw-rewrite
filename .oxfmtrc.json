{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 80,
	"tabWidth": 2,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"sortImports": {
		"internalPattern": ["@ocw/", "@/", "~/", "#"]
	},
	"sortPackageJson": false,
	"sortTailwindcss": {
		"functions": ["cn", "cva"]
	},
	"ignorePatterns": [
		".agents/**",
		".claude/**",
		"**/.claude/**",
		".next/**",
		"**/.next/**",
		".next-docs/**",
		".turbo/**",
		"**/.turbo/**",
		".alchemy/**",
		"**/.cache/**",
		"**/dist/**",
		"node_modules/**",
		"**/node_modules/**",
		"packages/backend/convex/_generated/**",
		"e2e-report/**",
		"playwright-report/**",
		"test-results/**",
		"agents.md",
		"skills-lock.json"
	]
}
